#!/usr/bin/env bash
# Spin up an isolated worktree + Rex session for a coding agent, and tear it down.
#
#   agent-session new <name> [--branch <existing-branch>] [--prompt <text> | --prompt-file <path>]
#   agent-session done <name> [--force]
#   agent-session ls
#   agent-session peek <name> [lines]
#   agent-session inbox [--wait [--timeout <seconds>] | --follow [--interval <seconds>]]
#   agent-session controller [extra prompt...]
#   agent-session panel [name]
#
# Run it from any git repo. `new` creates ../<repo>-worktrees/<name> (on a new agent/<name>
# branch off origin/<base>, or on an existing branch), copies the git-ignored files a worktree
# needs (COPY_FILES, default .env), and opens a Rex session with Agent (claude) and Tests
# (shell) tabs. <base> is origin's default branch (origin/HEAD), or master if that isn't set.
#
# Worktrees isolate the code, not anything the code talks to: a copied .env can hold live
# keys. Put the rules for that in .agent-session/agent-rules.md and they go into every
# agent's preamble.
#
# `done` closes the Rex session, removes the worktree and deletes the branch if it's
# merged into the local base branch (the controller merges agent branches locally). It
# refuses on uncommitted or unmerged work unless --force.
#
# The agent's Claude gets AGENT_SESSION_NAME and AGENT_SESSION_INBOX, so the Stop hook
# (agent-stop-hook) drops a report in the inbox each time the agent stops. The inbox is
# ${XDG_STATE_HOME:-~/.local/state}/agent-session/<prefix>/inbox (AGENT_SESSION_INBOX
# overrides). `inbox` prints unread reports, oldest first, and moves them to inbox/read/;
# `--wait` blocks until there is one (exit 2 after --timeout seconds, default 3600).
# `--follow` never exits on its own: it prints each report as it lands (checking every
# --interval seconds, default 2) until SIGINT/SIGTERM. Run one in the background for the session.
#
# `peek` prints the last lines of an agent's Agent tab. `controller` opens (or switches to) a
# Rex session named "<prefix>controller" in the main checkout, running a Claude that
# coordinates the agents by the practice doc. The controller runs on
# $AGENT_SESSION_CONTROLLER_MODEL (default sonnet) with the advisor on
# $AGENT_SESSION_ADVISOR_MODEL (default fable), so its judgment calls get a stronger model.
#
# `new` and `controller` also open `agent-panel` in a split beside the Agent tab's Claude
# (35% wide, not focused, following the checkout it was started for). AGENT_SESSION_PANEL=0 or
# PANEL=0 in the config turns that off; if agent-panel isn't on PATH it is skipped with a note,
# and a panel failure never fails the command. `panel` opens one by hand, beside the controller
# or beside agent session <name>.
#
# Optional per-project config in <repo>/.agent-session/:
#   config               KEY=value lines (never sourced): PREFIX, COPY_FILES (space-separated),
#                        PRACTICE_DOC, CONTROLLER_MODEL, ADVISOR_MODEL,
#                        PANEL (0 or 1)
#   agent-rules.md       extra rules inserted into every agent's preamble
#   controller-rules.md  extra rules appended to the controller's prompt
set -euo pipefail

# The directory this script really lives in (through symlinks): bin/ in a clone, the venv's bin/
# in a `uv tool install`. The helper lib sits next to it either way.
HERE="${BASH_SOURCE[0]}"
while [[ -L "$HERE" ]]; do
  link="$(readlink "$HERE")"
  [[ "$link" == /* ]] && HERE="$link" || HERE="$(dirname "$HERE")/$link"
done
HERE="$(cd "$(dirname "$HERE")" && pwd)"

# The shipped default practice doc: package data, in the clone or in the installed venv.
find_practice_doc() {
  local f
  for f in "$HERE"/../agent_panel/assets/controller-practice.md \
           "$HERE"/../lib/python*/site-packages/agent_panel/assets/controller-practice.md; do
    [[ -f "$f" ]] && { (cd "$(dirname "$f")" && echo "$PWD/$(basename "$f")"); return 0; }
  done
  echo "agent-session: can't find the shipped controller-practice.md" >&2
  return 1
}

ROOT="$(git worktree list --porcelain 2>/dev/null | awk 'NR==1 {print $2}' || true)"

PROG=agent-session
# shellcheck source=agent-session-lib.sh
source "$HERE/agent-session-lib.sh"

die() { echo "agent-session: $*" >&2; exit 1; }

usage() { sed -n '4,10p' "$0" | sed 's/^# \{0,3\}//'; exit 1; }

valid_name() { [[ "$1" =~ ^[a-z0-9][a-z0-9-]{0,40}$ ]] || die "name must be lowercase letters, digits and dashes: '$1'"; }

# Read KEY=value lines from a project config. Never sourced or eval'd: a cloned repo's
# config must not be able to run code. Only the known keys are accepted.
parse_config() { # parse_config <file>
  [[ -f "$1" ]] || return 0
  local line key val f
  while IFS= read -r line || [[ -n "$line" ]]; do
    [[ -z "${line//[[:space:]]/}" || "$line" =~ ^[[:space:]]*# ]] && continue
    [[ "$line" == *=* ]] || { echo "agent-session: ignoring config line without '=': $line" >&2; continue; }
    key="${line%%=*}"; val="${line#*=}"
    key="${key//[[:space:]]/}"
    val="${val#"${val%%[![:space:]]*}"}"; val="${val%"${val##*[![:space:]]}"}"
    if [[ "$val" =~ ^\"(.*)\"$ || "$val" =~ ^\'(.*)\'$ ]]; then val="${BASH_REMATCH[1]}"; fi
    case "$key" in
      PREFIX) [[ "$val" =~ ^[a-z0-9][a-z0-9-]{0,20}$ ]] || die "config: PREFIX must match ^[a-z0-9][a-z0-9-]{0,20}\$: '$val'"
              PREFIX="$val" ;;
      COPY_FILES) read -r -a COPY_FILES <<<"$val"
                  for f in ${COPY_FILES[@]+"${COPY_FILES[@]}"}; do safe_relpath COPY_FILES "$f"; done ;;
      PRACTICE_DOC) safe_relpath PRACTICE_DOC "$val"; PRACTICE_DOC="$val" ;;
      CONTROLLER_MODEL|ADVISOR_MODEL)
        check_model "config: $key" "$val"
        printf -v "$key" '%s' "$val" ;;
      PANEL) [[ "$val" == 0 || "$val" == 1 ]] || die "config: PANEL must be 0 or 1: '$val'"
             PANEL="$val" ;;
      *) echo "agent-session: ignoring unknown config key '$key' in $1" >&2 ;;
    esac
  done <"$1"
}

safe_relpath() { # safe_relpath <key> <path>: relative, no .. segment
  if [[ "$2" == /* || "$2" =~ (^|/)\.\.(/|$) ]]; then
    die "config: $1 entries must be relative paths without '..': '$2'"
  fi
}

load_config() {
  CONFIG_DIR="$ROOT/.agent-session"
  # Rex session labels are global across projects, so prefix ours.
  PREFIX="$(basename "$ROOT")-"
  COPY_FILES=(.env)
  PRACTICE_DOC="$(find_practice_doc)" || exit 1
  [[ -f "$ROOT/ai-ops/local-config/agent-sessions.md" ]] && PRACTICE_DOC="ai-ops/local-config/agent-sessions.md"
  CONTROLLER_MODEL=sonnet
  ADVISOR_MODEL=fable
  PANEL=1
  parse_config "$CONFIG_DIR/config"
  CONTROLLER="${PREFIX}controller"
  CONTROLLER_MODEL="${AGENT_SESSION_CONTROLLER_MODEL:-$CONTROLLER_MODEL}"
  ADVISOR_MODEL="${AGENT_SESSION_ADVISOR_MODEL:-$ADVISOR_MODEL}"
  check_model AGENT_SESSION_CONTROLLER_MODEL "$CONTROLLER_MODEL"
  check_model AGENT_SESSION_ADVISOR_MODEL "$ADVISOR_MODEL"
  PANEL="${AGENT_SESSION_PANEL:-$PANEL}"
  INBOX="${AGENT_SESSION_INBOX:-${XDG_STATE_HOME:-$HOME/.local/state}/agent-session/${PREFIX%-}/inbox}"
  WORKTREES="$(dirname "$ROOT")/$(basename "$ROOT")-worktrees"
  BASE="$(git -C "$ROOT" symbolic-ref --short refs/remotes/origin/HEAD 2>/dev/null || true)"
  BASE="${BASE#origin/}"
  BASE="${BASE:-master}"
}

# Print a config file's text, if the project has it.
config_text() { if [[ -s "$CONFIG_DIR/$1" ]]; then cat "$CONFIG_DIR/$1"; fi; }

ROLLBACK_WT="" ROLLBACK_BRANCH="" ROLLBACK_SID=""
rollback() {
  local status=$?
  [[ "$status" -ne 0 && -n "$ROLLBACK_WT" ]] || return 0
  echo "== Setup failed; rolling back" >&2
  [[ -n "$ROLLBACK_SID" ]] && rex kill "$ROLLBACK_SID" >/dev/null 2>&1
  git -C "$ROOT" worktree remove --force "$ROLLBACK_WT" || true
  [[ -n "$ROLLBACK_BRANCH" ]] && git -C "$ROOT" branch -D "$ROLLBACK_BRANCH" >/dev/null 2>&1
  exit "$status"
}
trap rollback EXIT


preamble() { # preamble <worktree> <branch>
  cat <<EOF
You are working in an isolated git worktree. Before anything else, run \`pwd\` and
\`git branch --show-current\` and confirm they are $1 and $2. Every edit,
command and commit happens in this directory, never in $ROOT.

EOF
  config_text agent-rules.md
  cat <<EOF
- Commit with a trailing pathspec. Don't push.
- When you stop, end with your report as your last message: a Stop hook delivers it to the
  controller. Never type into another Rex session or pane (the controller's included).

Task:
EOF
}

cmd_new() {
  local name="${1:-}"; [[ -n "$name" ]] || usage; shift
  local branch="" prompt=""
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --branch) branch="$2"; shift 2 ;;
      --prompt) prompt="$2"; shift 2 ;;
      --prompt-file) [[ -s "$2" ]] || die "prompt file missing or empty: $2"; prompt="$(cat "$2")"; shift 2 ;;
      *) usage ;;
    esac
  done
  valid_name "$name"
  command -v rex >/dev/null || die "rex not found"
  command -v jq >/dev/null || die "jq not found"

  local wt="$WORKTREES/$name"
  [[ -e "$wt" ]] && die "$wt already exists"
  [[ -z "$(rex_session_id "$PREFIX$name")" ]] || die "a Rex session named '$PREFIX$name' already exists"

  echo "== Creating worktree $wt"
  mkdir -p "$WORKTREES"
  # The local base branch can lag origin (someone else pushed), so fetch first and fail
  # rather than start from a stale one.
  if [[ -n "$branch" ]]; then
    git -C "$ROOT" fetch --quiet origin "$branch" 2>/dev/null || true
    git -C "$ROOT" worktree add --quiet "$wt" "$branch"
  else
    branch="agent/$name"
    git -C "$ROOT" fetch --quiet origin "$BASE"
    # --no-track: otherwise the branch's upstream becomes origin/<base> and a bare push goes there.
    git -C "$ROOT" worktree add --quiet --no-track -b "$branch" "$wt" "origin/$BASE"
    ROLLBACK_BRANCH="$branch"
  fi
  ROLLBACK_WT="$wt"

  echo "== Copying git-ignored files"
  local f
  for f in ${COPY_FILES[@]+"${COPY_FILES[@]}"}; do
    if [[ -f "$ROOT/$f" ]]; then
      mkdir -p "$(dirname "$wt/$f")"
      cp "$ROOT/$f" "$wt/$f"
    else
      echo "agent-session: warning: $f not found in $ROOT, not copied" >&2
    fi
  done
  command -v direnv >/dev/null && direnv allow "$wt" >/dev/null 2>&1 || true

  echo "== Opening Rex session '$PREFIX$name'"
  local sid out
  local agent=("${CLAUDE_ENV[@]}" AGENT_SESSION_NAME="$name" AGENT_SESSION_INBOX="$INBOX" claude)
  if [[ -n "$prompt" ]]; then
    out="$(rex new "$PREFIX$name" -c "$wt" --window Agent --json -- "${agent[@]}" "$(preamble "$wt" "$branch")
$prompt")"
  else
    out="$(rex new "$PREFIX$name" -c "$wt" --window Agent --json -- "${agent[@]}")"
  fi
  sid="$(jq -er '.session_id' <<<"$out")"
  ROLLBACK_SID="$sid"
  rex window new -s "$sid" Tests -c "$wt" --focus=false --keep-open --json -- "$SHELL" >/dev/null
  [[ "$PANEL" == 0 ]] || open_panel "$sid" "$(jq -r '.initial_windows[0].block_ids[0] // empty' <<<"$out" 2>/dev/null || true)" "$wt"

  cat <<EOF

Ready.
  worktree:  $wt
  branch:    $branch
  rex:       $sid ($PREFIX$name)
Tear down with: agent-session done $name
EOF
}

cmd_done() {
  local name="${1:-}"; [[ -n "$name" ]] || usage; shift
  local force=0
  [[ "${1:-}" == "--force" ]] && force=1
  valid_name "$name"
  local wt="$WORKTREES/$name"
  [[ -d "$wt" ]] || die "no worktree at $wt"

  local branch
  branch="$(git -C "$wt" branch --show-current)"
  if [[ "$force" == 0 ]]; then
    [[ -z "$(git -C "$wt" status --porcelain)" ]] || die "$wt has uncommitted changes (use --force to discard)"
    local unmerged
    unmerged="$(git -C "$ROOT" log --oneline "$BASE..$branch")"
    [[ -z "$unmerged" ]] || die "$branch has commits that aren't merged into $BASE (use --force to abandon):
$unmerged"
  fi

  local sid
  sid="$(rex_session_id "$PREFIX$name" || true)"
  if [[ -n "$sid" ]]; then
    echo "== Closing Rex session $sid"
    rex kill "$sid" >/dev/null || true
  fi

  echo "== Removing worktree"
  git -C "$ROOT" worktree remove --force "$wt"
  git -C "$ROOT" worktree prune
  if [[ -n "$branch" && "$branch" != "$BASE" ]]; then
    git -C "$ROOT" merge-base --is-ancestor "$branch" "$BASE" && git -C "$ROOT" branch -D "$branch" >/dev/null &&
      echo "== Deleted merged branch $branch" ||
      echo "== Kept branch $branch (not merged into $BASE)"
  fi
}

cmd_ls() {
  local wt name
  for wt in "$WORKTREES"/*/; do
    [[ -d "$wt" ]] || continue
    name="$(basename "$wt")"
    printf '%-28s %-36s rex %s\n' "$name" "$(git -C "$wt" branch --show-current)" \
      "$([[ -n "$(rex_session_id "$PREFIX$name")" ]] && echo open || echo closed)"
  done
}

cmd_peek() {
  local name="${1:-}" lines="${2:-40}" sid
  [[ -n "$name" ]] || usage
  sid="$(rex_session_id "$PREFIX$name")"
  [[ -n "$sid" ]] || die "no Rex session named '$PREFIX$name'"
  rex capture -s "$sid" -w Agent --trim --unwrap | tail -n "$lines"
}

inbox_entries() { # unread reports, oldest first (by the <epoch> suffix the hook writes)
  local f
  for f in "$INBOX"/*; do
    if [[ -f "$f" ]]; then echo "${f##*-} $f"; fi
  done | sort -n | cut -d' ' -f2-
}

WARNED=$'\n' # reports already warned about, one per line, so a stuck one warns only once
PRINTED=0    # reports the last print_inbox actually printed

print_reports() { # print_reports <entries>: claim each report by moving it to read/, then print it
  local f name dest n body
  PRINTED=0
  mkdir -p "$INBOX/read"
  while IFS= read -r f; do
    name="$(basename "$f")"
    if [[ ! -r "$f" ]]; then # gone (another reader got it) or unreadable: leave it, skip it
      if [[ -e "$f" && "$WARNED" != *$'\n'"$f"$'\n'* ]]; then
        echo "agent-session: can't read $f; leaving it in the inbox" >&2
        WARNED+="$f"$'\n'
      fi
      continue
    fi
    # Never overwrite an archived report (the same agent can stop twice in one second).
    dest="$INBOX/read/$name"; n=1
    while [[ -e "$dest" ]]; do dest="$INBOX/read/$name.$n"; n=$((n + 1)); done
    # The move is the claim: if another reader moved it first, it prints there, not here.
    mv "$f" "$dest" 2>/dev/null || continue
    if ! body="$(cat "$dest" && echo .)"; then
      echo "agent-session: can't read $dest" >&2
      continue
    fi
    # cmd_inbox ignores SIGPIPE, so a closed reader fails the write here instead of killing us
    # with the report already archived: put it back unread and stop.
    if ! printf '== %s\n%s\n' "$name" "${body%.}" 2>/dev/null; then
      mv "$dest" "$f" 2>/dev/null || true
      echo "agent-session: output closed; left $name in the inbox" >&2
      exit 1
    fi
    PRINTED=$((PRINTED + 1))
  done <<<"$1"
}

print_inbox() { # print every unread report it can; PRINTED says how many it did
  local entries
  PRINTED=0
  entries="$(inbox_entries)"
  if [[ -n "$entries" ]]; then print_reports "$entries"; fi # not `||`: that would switch off set -e in it
}

follow_inbox() { # follow_inbox <interval>: print reports as they land until SIGINT/SIGTERM
  local interval="$1" stop=0 sleeper=""
  # The trap only sets a flag (and cuts the sleep short), so a report being printed is
  # always finished before we exit. print_reports claims each report before printing it,
  # so one running alongside a plain `inbox` never prints a report twice.
  trap 'stop=1; [[ -z "$sleeper" ]] || kill "$sleeper" 2>/dev/null || true' INT TERM
  while [[ "$stop" == 0 ]]; do
    print_inbox
    [[ "$stop" == 0 ]] || break
    sleep "$interval" &
    sleeper=$!
    [[ "$stop" == 0 ]] || kill "$sleeper" 2>/dev/null || true # a signal that beat $! being set
    wait "$sleeper" 2>/dev/null || true
    sleeper=""
  done
}

cmd_inbox() {
  local wait=0 follow=0 timeout="" interval="" waited=0
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --wait) wait=1; shift ;;
      --follow) follow=1; shift ;;
      --timeout) [[ "${2:-}" =~ ^[0-9]+$ ]] || die "--timeout needs a number of seconds"; timeout="$2"; shift 2 ;;
      --interval)
        [[ "${2:-}" =~ ^[0-9]*\.?[0-9]+$ && ! "$2" =~ ^[0.]+$ ]] || die "--interval needs a number of seconds above 0"
        interval="$2"; shift 2 ;;
      *) usage ;;
    esac
  done
  [[ "$follow$wait" != 11 ]] || die "--follow and --wait can't be used together: --follow keeps printing reports, --wait prints one batch and exits"
  [[ -z "$interval" || "$follow" == 1 ]] || die "--interval only goes with --follow"
  [[ -z "$timeout" || "$follow" == 0 ]] || die "--timeout doesn't go with --follow, which runs until stopped"
  timeout="${timeout:-3600}"
  trap '' PIPE # see print_reports
  if [[ "$follow" == 1 ]]; then
    follow_inbox "${interval:-2}"
    return
  fi
  # Decide by what was printed, not what was listed: a report can be unreadable, or another
  # reader can claim it first.
  if [[ "$wait" == 1 ]]; then
    while true; do # not `while print_inbox`: a while condition switches off set -e in it
      print_inbox
      if ((PRINTED > 0)); then return; fi
      if ((waited >= timeout)); then
        echo "agent-session: no agent reports after ${timeout}s" >&2
        exit 2
      fi
      sleep 3
      waited=$((waited + 3))
    done
  fi
  print_inbox
  if ((PRINTED == 0)); then echo "no new agent reports"; fi
}

controller_prompt() {
  cat <<EOF
You are the controller for parallel agent sessions on this repo. You run in the main
checkout ($ROOT) on $BASE. Before anything else:

1. Read $PRACTICE_DOC and follow it for the whole session.
2. Run \`git status\` and \`agent-session ls\`, then \`agent-session peek <name> 15\`
   for each open session.
3. Report a short board: each session, its branch, what it is doing or waiting on, and any
   overlap between sessions in the files they touch. Then wait for instructions.

Start one \`agent-session inbox --follow\` in the background for the whole session (not one
per agent, and never a second one); it prints each agent report as it arrives. Peek the
agent(s) each report names.

You don't write feature or fix code here; you start agents for that.

EOF
  config_text controller-rules.md
  cat <<EOF
Call the advisor before you write a brief or split work between agents, before you merge an
agent's branch, before you put a live write to the user, and whenever two agents' reports
conflict.
EOF
}

cmd_controller() { # cmd_controller [extra prompt words...], appended after the generated prompt
  local extra="$*"
  command -v rex >/dev/null || die "rex not found"
  command -v jq >/dev/null || die "jq not found"
  local existing
  existing="$(rex_session_id "$CONTROLLER")"
  if [[ -n "$existing" ]]; then
    show_in_app "$existing"
    echo "Controller already open in Rex session $existing; switched to it."
    return
  fi
  local current
  current="$(git -C "$ROOT" branch --show-current)"
  [[ "$current" == "$BASE" ]] || echo "warning: the main checkout is on '$current', not $BASE" >&2

  local sid out
  out="$(rex new "$CONTROLLER" -c "$ROOT" --window Agent --json -- "${CLAUDE_ENV[@]}" claude --model "$CONTROLLER_MODEL" \
    --settings "{\"advisorModel\":\"$ADVISOR_MODEL\"}" "$(controller_prompt)${extra:+$'\n\n'$extra}")"
  sid="$(jq -er '.session_id' <<<"$out")"
  rex window new -s "$sid" Shell -c "$ROOT" --focus=false --keep-open --json -- "$SHELL" >/dev/null
  [[ "$PANEL" == 0 ]] || open_panel "$sid" "$(jq -r '.initial_windows[0].block_ids[0] // empty' <<<"$out" 2>/dev/null || true)" "$ROOT"
  show_in_app "$sid"
  echo "Controller ready in Rex session $sid (tabs: Agent, Shell)."
}

# Open the panel by hand beside the controller (no name) or agent session <name>.
cmd_panel() {
  local name="${1:-}" label="$CONTROLLER" dir="$ROOT" sid block
  if [[ -n "$name" ]]; then
    valid_name "$name"
    label="$PREFIX$name"; dir="$WORKTREES/$name"
    [[ -d "$dir" ]] || die "no worktree at $dir"
  fi
  command -v rex >/dev/null || die "rex not found"
  command -v jq >/dev/null || die "jq not found"
  command -v agent-panel >/dev/null || die "agent-panel not on PATH"
  sid="$(rex_session_id "$label")"
  [[ -n "$sid" ]] || die "no Rex session named '$label' is open"
  block="$(rex window ls -s "$sid" --json | jq -r '[.windows[] | select(.label == "Agent") | .layers[].blocks[]?.block_id][0] // empty')"
  [[ -n "$block" ]] || die "no Agent tab in Rex session '$label'"
  rex split -s "$sid" -b "$block" --split=right --ratio 35 --label Agents --focus=false -c "$dir" -- agent-panel >/dev/null ||
    die "rex split failed"
  echo "Panel opened beside the Agent tab of '$label'."
}

# Subcommands need a repo; usage doesn't.
repo_cmd() { [[ -n "$ROOT" ]] || die "not inside a git repository"; load_config; "$@"; }

case "${1:-}" in
  new) shift; repo_cmd cmd_new "$@" ;;
  done) shift; repo_cmd cmd_done "$@" ;;
  ls) shift; repo_cmd cmd_ls "$@" ;;
  peek) shift; repo_cmd cmd_peek "$@" ;;
  inbox) shift; repo_cmd cmd_inbox "$@" ;;
  controller) shift; repo_cmd cmd_controller "$@" ;;
  panel) shift; repo_cmd cmd_panel "$@" ;;
  *) usage ;;
esac
